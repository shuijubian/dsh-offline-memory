{
  "name": "dsh-offline-memory",
  "version": "2.2.1",
  "description": "外置记忆：按会话独立存档，上下文被压缩或清空后仍能接上。三层存储 + 注入去重（可关）+ 人设指纹 + 偏好库 + 外部源（按会话，读不到会告警）+ 图片记忆 + 表情包收录 + 存档迁移清单 + 自更新（本地 zip / GitHub）。",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "安装与使用说明.md"
  ],
  "scripts": {
    "stat": "node lib/stat.mjs",
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
