{
  "name": "dsh-offline-memory",
  "version": "2.1.1",
  "description": "外置记忆：按会话独立存档，上下文被压缩或清空后仍能接上而不是复活。三层（底层原文 / 优化存储 / 虚拟上下文）+ 注入去重（内容级）+ 人设指纹可核对 + 图片记忆 + 存档迁移 + 自更新（本地 zip / GitHub）。",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "AGENT-GUIDE.md"
  ],
  "scripts": {
    "stat": "node lib/stat.mjs",
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
